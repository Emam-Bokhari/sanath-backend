# Server Configuration
IP=127.0.0.1
PORT=5009
NODE_ENV=development

# Database Connection (MongoDB)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# DATABASE_URL=mongodb://localhost:27017/sanath

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=your_encryption_key_here

# Response Handling Mode (STRICT or SOFT)
RESPONSE_MODE=STRICT

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend & External Application URLs
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:4173
BASE_URL=http://localhost:5009
BRAND_NAME="My Home"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
jwtRefreshSecret=your_jwt_refresh_secret_here
JWT_EXPIRE_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# Cron & Feed Synchronization
START_CRON=false
KYERO_FEED_URL=https://feeds.kyero.com/assets/kyero_v3_test_feed.xml
KYERO_CRON_INTERVAL=0 * * * *

# Google / Firebase Admin SDK
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENT_SUCCESS=http://localhost:3000/payment-success
CURRENCY=usd

# CinetPay Webhook Secret
CINETPAY_SECRET_KEY=

# Nodemailer / SMTP Email Configuration
EMAIL_FROM_NAME="My Home"
EMAIL_FROM=noreply@example.com
EMAIL_USER=your_email@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PASS=your_app_password
EMAIL_PORT=587
SUPPORT_RECEIVER_EMAIL=support@example.com

# Initial Super Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Twilio SMS & OTP Service
TWILIO_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Social Media OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=